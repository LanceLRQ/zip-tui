{
  "name": "zip-tui",
  "version": "0.1.0-dev",
  "description": "A TUI-driven archive command dispatcher for macOS & Linux",
  "type": "module",
  "bin": { "zt": "./dist/zt.js" },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --target=bun ./src/index.ts --outfile dist/zt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit"
  },
  "engines": { "bun": ">=1.1.0" }
}
