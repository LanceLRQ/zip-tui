{
  "name": "zip-tui",
  "version": "0.1.0-dev",
  "description": "A TUI-driven archive command dispatcher for macOS & Linux",
  "type": "module",
  "bin": {
    "zt": "./dist/zt.js"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build --compile --target=bun --external react-devtools-core ./src/index.ts --outfile dist/zt",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "dependencies": {
    "clipboardy": "^5.3.1",
    "commander": "^14.0.3",
    "conf": "^15.1.0",
    "execa": "^9.6.1",
    "globby": "^16.2.0",
    "i18next": "^26.2.0",
    "iconv-lite": "^0.7.2",
    "ink": "^7.0.3",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "ink-text-input": "^6.0.0",
    "pino": "^10.3.1",
    "react": "^19.2.6",
    "which": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/which": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.6",
    "bun-types": "^1.3.14",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
